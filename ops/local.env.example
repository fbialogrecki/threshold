# Operator-specific settings for the scripts in ops/.
#
# Copy this file to ops/local.env (gitignored) and replace every placeholder.
# Format: KEY=VALUE per line; quote values that contain spaces. The file is
# parsed, not executed. A variable set in the environment overrides the file.

# --- Personal Bitwarden vault (bw CLI) --------------------------------------
# Account the bw CLI logs into, and the server it uses (for example the EU or
# US cloud, or a self-hosted instance).
BW_ACCOUNT_EMAIL=operator@example.com
BW_SERVER_URL=https://vault.bitwarden.example

# Vault item that holds the Bitwarden Secrets Manager machine-account access
# token (in a custom field named BWS_ACCESS_TOKEN, the login password, or notes).
BW_BWS_ACCESS_TOKEN_ITEM="Example BWS access token item"

# Vault item that holds the fine-grained GitHub PAT used for release promotion
# (ops/rotate-release-token-from-bitwarden.sh creates it if it is missing).
BW_GITHUB_TOKEN_ITEM="Example release token item"

# --- Bitwarden Secrets Manager (bws CLI) ------------------------------------
BWS_SERVER_URL=https://vault.bitwarden.example
# Optional: limit `bws secret list` to one project.
BWS_PROJECT_ID=

# BWS secret names, separated by "|".
# OpenBao unseal key shares, submitted in order until OpenBao unseals.
BWS_OPENBAO_UNSEAL_SECRET_NAMES="example-unseal-share-1|example-unseal-share-2|example-unseal-share-3"
# Candidates for a write-capable OpenBao token; the first non-empty one wins.
BWS_OPENBAO_TOKEN_SECRET_NAMES="example-openbao-admin-token"

# --- Release credentials ----------------------------------------------------
# GitHub user that owns the release PAT; stored next to it in OpenBao.
OPENBAO_GIT_USERNAME=example-github-user

# --- Network ----------------------------------------------------------------
# LAN address of the Harbor registry, used by release builds when the registry
# hostname does not resolve inside the CI pod.
HARBOR_IP=192.0.2.10
